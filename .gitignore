# =============================================================
# Unity .gitignore — for simulation/ folder
# =============================================================

# Unity generated folders
simulation/[Ll]ibrary/
simulation/[Tt]emp/
simulation/[Oo]bj/
simulation/[Bb]uild/
simulation/[Bb]uilds/
simulation/[Ll]ogs/
simulation/[Uu]ser[Ss]ettings/
simulation/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!simulation/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# simulation/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
simulation/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
simulation/.vs/

# Gradle cache directory
simulation/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
simulation/ExportedObj/
simulation/.consulo/
simulation/*.csproj
simulation/*.unityproj
simulation/*.sln
simulation/*.suo
simulation/*.tmp
simulation/*.user
simulation/*.userprefs
simulation/*.pidb
simulation/*.booproj
simulation/*.svd
simulation/*.pdb
simulation/*.mdb
simulation/*.opendb
simulation/*.VC.db

# Unity3D generated meta files
simulation/*.pidb.meta
simulation/*.pdb.meta
simulation/*.mdb.meta

# Unity3D generated file on crash reports
simulation/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
simulation/crashlytics-build.properties

# Packed Addressables
simulation/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
simulation/[Aa]ssets/[Ss]treamingAssets/aa.meta
simulation/[Aa]ssets/[Ss]treamingAssets/aa/*

# Recordings can be ignored if too large (uncomment if needed)
# simulation/[Rr]ecordings/

# =============================================================
# Python .gitignore — for scripts/ folder
# =============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
.env

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Environment variables / API keys (IMPORTANT!)
.env
.env.local
*.key
api_keys.txt
config.json
secrets.json

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# =============================================================
# Large third-party Unity Asset Store models
# Re-download from Unity Asset Store / Sketchfab if needed
# =============================================================
simulation/Assets/MODELS/
simulation/Assets/MODELS.meta
